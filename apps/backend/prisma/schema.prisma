// CoopManage Rwanda — database schema.
// Documented in docs/database.md. Tables are introduced by the migration plan in section 15;
// this file grows one migration at a time rather than being written all at once.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// M1 (Phase 1) — reference data.
// Seeded, not user-created. Roles and permissions are the vocabulary the whole
// authorization system is written in, so they exist before anything else.
// ---------------------------------------------------------------------------

enum PermissionScope {
  COOPERATIVE
  PLATFORM
}

enum RoleScope {
  COOPERATIVE
  PLATFORM
}

model Permission {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key           String          @unique
  resource      String
  action        String
  scope         PermissionScope
  descriptionEn String          @map("description_en")
  descriptionRw String          @map("description_rw")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles     RolePermission[]
  overrides StaffPermissionOverride[]

  @@index([scope])
  @@map("permissions")
}

model Role {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key           String    @unique
  nameEn        String    @map("name_en")
  nameRw        String    @map("name_rw")
  descriptionEn String    @map("description_en")
  descriptionRw String    @map("description_rw")
  scope         RoleScope
  isSystem      Boolean   @default(true) @map("is_system")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  staff       CooperativeStaff[]

  @@map("roles")
}

// Child of Role, which is platform-level, so it carries no cooperative_id.
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model CooperativeType {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                 String   @unique
  nameEn              String   @map("name_en")
  nameRw              String   @map("name_rw")
  descriptionEn       String   @map("description_en")
  descriptionRw       String   @map("description_rw")
  iconKey             String   @map("icon_key")
  defaultUnitKeys     String[] @map("default_unit_keys")
  suggestedCategories Json     @map("suggested_categories")
  sortOrder           Int      @map("sort_order")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cooperatives Cooperative[]

  @@map("cooperative_types")
}

// ---------------------------------------------------------------------------
// M2 (Phase 2) — identity, tenancy and the audit trail.
//
// `Cooperative` lands here rather than with the cooperative module in Phase 3:
// `CooperativeStaff` is the tenant gate and cannot exist without it, and Phase 2
// needs the gate. `UnitOfMeasure` lands here too, because it carries a nullable
// cooperative_id and so cannot precede the table it points at.
// Ordering is fixed by docs/database.md section 15.
// ---------------------------------------------------------------------------

enum Locale {
  EN
  RW
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CooperativeStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum OverrideEffect {
  GRANT
  DENY
}

/// Platform-level identity. One person may serve more than one cooperative, so nothing here is
/// tenant-scoped; membership lives in CooperativeStaff.
model User {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String     @unique @db.Citext
  passwordHash       String     @map("password_hash")
  fullName           String     @map("full_name")
  phone              String?
  locale             Locale     @default(EN)
  isPlatformAdmin    Boolean    @default(false) @map("is_platform_admin")
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshSessions        RefreshSession[]
  passwordResetTokens    PasswordResetToken[]
  staff                  CooperativeStaff[]        @relation("StaffUser")
  invitedStaff           CooperativeStaff[]        @relation("StaffInviter")
  grantedOverrides       StaffPermissionOverride[]
  auditEntries           AuditLog[]
  updatedCoopSettings    CooperativeSetting[]
  updatedSysSettings     SystemSetting[]
  membersCreated         Member[]                  @relation("MemberCreatedBy")
  membersUpdated         Member[]                  @relation("MemberUpdatedBy")
  sharesCreated          MemberShare[]             @relation("ShareCreatedBy")
  sharesVoided           MemberShare[]             @relation("ShareVoidedBy")
  contributionsCreated   Contribution[]            @relation("ContributionCreatedBy")
  contributionsVoided    Contribution[]            @relation("ContributionVoidedBy")
  financeCreated         FinanceTransaction[]      @relation("FinanceCreatedBy")
  financeVoided          FinanceTransaction[]      @relation("FinanceVoidedBy")
  idempotencyKeys        IdempotencyKey[]
  productsCreated        Product[]                 @relation("ProductCreatedBy")
  buyersCreated          Buyer[]                   @relation("BuyerCreatedBy")
  salesCreated           Sale[]                    @relation("SaleCreatedBy")
  reportsGenerated       ReportRun[]               @relation("ReportGeneratedBy")
  documentsUploaded      Document[]                @relation("DocumentUploadedBy")
  documentsArchived      Document[]                @relation("DocumentArchivedBy")
  meetingsCreated        Meeting[]                 @relation("MeetingCreatedBy")
  inventoryCreated       InventoryTransaction[]    @relation("InventoryCreatedBy")
  notifications          Notification[]
  announcementsWritten   Announcement[]            @relation("AnnouncementAuthor")
  announcementsPublished Announcement[]            @relation("AnnouncementPublisher")
  smsSent                SmsMessage[]              @relation("SmsSender")
  assistantThreads       AssistantConversation[]

  @@index([status])
  @@map("users")
}

/// One row per signed-in device. Refresh tokens are opaque and stored only as a hash, so a
/// database leak yields nothing that can be presented back to the API.
model RefreshSession {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  /// Every token rotated from the same login shares this id. Presenting an already-rotated token
  /// revokes the whole family, which is how a stolen token is detected.
  familyId     String    @map("family_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([familyId])
  @@map("refresh_sessions")
}

/// Single use, 60 minute lifetime. The request endpoint answers identically for a known and an
/// unknown address, so this table cannot be used to enumerate users.
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// The tenant. Every tenant-owned row in every later migration points back here.
model Cooperative {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String            @unique
  name                 String
  typeId               String            @map("type_id") @db.Uuid
  registrationNumber   String?           @unique @map("registration_number")
  tinNumber            String?           @map("tin_number")
  province             String
  district             String
  sector               String
  cell                 String
  village              String
  addressLine          String?           @map("address_line")
  phone                String?
  email                String?
  logoUrl              String?           @map("logo_url")
  foundedOn            DateTime?         @map("founded_on") @db.Date
  status               CooperativeStatus @default(ACTIVE)
  /// Flagged once, on the cooperative. Everything else is reachable from here by foreign key, so a
  /// per-row flag would be redundant and would eventually be forgotten on some table.
  isDemo               Boolean           @default(false) @map("is_demo")
  currency             String            @default("RWF")
  timezone             String            @default("Africa/Kigali")
  defaultLocale        Locale            @default(RW) @map("default_locale")
  memberCodePrefix     String            @default("COOP") @map("member_code_prefix")
  memberCodeSequence   Int               @default(0) @map("member_code_sequence")
  fiscalYearStartMonth Int               @default(1) @map("fiscal_year_start_month")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  type                CooperativeType         @relation(fields: [typeId], references: [id], onDelete: Restrict)
  staff               CooperativeStaff[]
  units               UnitOfMeasure[]
  auditLog            AuditLog[]
  settings            CooperativeSetting[]
  members             Member[]
  memberShares        MemberShare[]
  contributions       Contribution[]
  financeCategories   FinanceCategory[]
  financeTransactions FinanceTransaction[]
  idempotencyKeys     IdempotencyKey[]
  productCategories   ProductCategory[]
  products            Product[]
  warehouses          Warehouse[]
  stockLevels         StockLevel[]
  inventory           InventoryTransaction[]
  notifications       Notification[]
  buyers              Buyer[]
  sales               Sale[]
  reportRuns          ReportRun[]
  documents           Document[]
  meetings            Meeting[]
  announcements       Announcement[]
  smsMessages         SmsMessage[]
  assistantThreads    AssistantConversation[]

  @@index([status])
  @@map("cooperatives")
}

/// The membership row that makes a user part of a cooperative. This table is the tenant gate:
/// without an ACTIVE row here, no request may read or write anything belonging to the cooperative.
model CooperativeStaff {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId String      @map("cooperative_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  roleId        String      @map("role_id") @db.Uuid
  jobTitle      String?     @map("job_title")
  status        StaffStatus @default(ACTIVE)
  invitedById   String?     @map("invited_by_id") @db.Uuid
  invitedAt     DateTime    @default(now()) @map("invited_at") @db.Timestamptz(3)
  joinedAt      DateTime?   @map("joined_at") @db.Timestamptz(3)
  deactivatedAt DateTime?   @map("deactivated_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  cooperative          Cooperative               @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  user                 User                      @relation("StaffUser", fields: [userId], references: [id], onDelete: Restrict)
  role                 Role                      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy            User?                     @relation("StaffInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  overrides            StaffPermissionOverride[]
  agendaItems          MeetingAgendaItem[]       @relation("AgendaPresenter")
  meetingAttendance    MeetingAttendee[]         @relation("AttendeeStaff")
  decisionsResponsible MeetingDecision[]         @relation("DecisionResponsible")

  @@unique([cooperativeId, userId])
  @@index([userId, status])
  @@index([cooperativeId, status])
  @@index([roleId])
  @@map("cooperative_staff")
}

/// A single grant or deny on top of the role, so a cooperative with unusual staffing does not force
/// a new role into existence. Evaluated as: role permissions + GRANT − DENY.
model StaffPermissionOverride {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffId      String         @map("staff_id") @db.Uuid
  permissionId String         @map("permission_id") @db.Uuid
  effect       OverrideEffect
  grantedById  String?        @map("granted_by_id") @db.Uuid
  reason       String?
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  staff      CooperativeStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  permission Permission       @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  grantedBy  User?            @relation(fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([staffId, permissionId])
  @@index([permissionId])
  @@map("staff_permission_overrides")
}

/// Append only. The application exposes no update or delete path, and the production database role
/// is granted INSERT and SELECT on this table only. `before` and `after` pass through the same
/// redaction list as the logger, so a password hash or a token can never land here.
model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null means a platform-level action that belongs to no cooperative.
  cooperativeId String?  @map("cooperative_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  /// Name and email captured at the time, so the log stays readable after a user is renamed.
  actorLabel    String   @map("actor_label")
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  messageKey    String   @map("message_key")
  messageParams Json?    @map("message_params")
  before        Json?
  after         Json?
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  requestId     String?  @map("request_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  cooperative Cooperative? @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  actor       User?        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([cooperativeId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_log")
}

/// A null cooperativeId is a system-wide seeded unit. Uniqueness needs two partial indexes, added
/// by the migration: in PostgreSQL two NULLs do not compare equal, so a plain
/// unique (cooperative_id, key) would allow duplicate system units.
model UnitOfMeasure {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId String?  @map("cooperative_id") @db.Uuid
  key           String
  nameEn        String   @map("name_en")
  nameRw        String   @map("name_rw")
  symbol        String
  precision     Int      @default(2)
  baseUnitId    String?  @map("base_unit_id") @db.Uuid
  factorToBase  Decimal? @map("factor_to_base") @db.Decimal(18, 6)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cooperative  Cooperative?           @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  baseUnit     UnitOfMeasure?         @relation("UnitBase", fields: [baseUnitId], references: [id], onDelete: Restrict)
  derivedUnits UnitOfMeasure[]        @relation("UnitBase")
  products     Product[]
  movements    InventoryTransaction[]
  saleItems    SaleItem[]

  @@index([cooperativeId, isActive])
  @@index([baseUnitId])
  @@map("units_of_measure")
}

// ---------------------------------------------------------------------------
// M3 (Phase 3) — configuration.
// Per-tenant and platform-wide settings that do not deserve a column: low-stock
// defaults, enabled modules, receipt footers, and the platform's own switches.
// ---------------------------------------------------------------------------

model CooperativeSetting {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId String   @map("cooperative_id") @db.Uuid
  key           String
  value         Json
  updatedById   String?  @map("updated_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cooperative Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  updatedBy   User?       @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([cooperativeId, key])
  @@index([cooperativeId])
  @@map("cooperative_settings")
}

model SystemSetting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// M4 (Phase 4) — members, and the money ledger they post into.
//
// The finance tables land here rather than in Phase 5 because a contribution
// creates its linked income row in the same transaction: the contribution is
// the member-facing view, the finance transaction is the accounting view, and
// there is exactly one source of truth for the money.
// ---------------------------------------------------------------------------

enum Gender {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}

enum MemberPosition {
  MEMBER
  COMMITTEE
  SECRETARY
  TREASURER
  VICE_CHAIR
  CHAIRPERSON
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  EXITED
}

enum ShareTransactionType {
  PURCHASE
  TRANSFER_IN
  TRANSFER_OUT
  REDEMPTION
}

enum ContributionType {
  MEMBERSHIP_FEE
  SAVINGS
  SHARE_CAPITAL
  SPECIAL_LEVY
  PENALTY
  OTHER
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK
  CHEQUE
  OTHER
}

enum FinanceKind {
  INCOME
  EXPENSE
}

enum FinanceSourceType {
  MANUAL
  SALE
  CONTRIBUTION
  SHARE_PURCHASE
  MEMBER_PAYMENT
  STOCK_PURCHASE
}

enum PostingStatus {
  POSTED
  VOID
}

enum IdempotencyState {
  IN_PROGRESS
  COMPLETED
}

model Member {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId String         @map("cooperative_id") @db.Uuid
  /// `COOP-00452`. Allocated from Cooperative.member_code_sequence inside the insert transaction,
  /// so two people registering at once cannot be given the same code.
  memberCode    String         @map("member_code")
  firstName     String         @map("first_name")
  lastName      String         @map("last_name")
  gender        Gender         @default(UNSPECIFIED)
  dateOfBirth   DateTime?      @map("date_of_birth") @db.Date
  /// Stored only when supplied, and masked in list responses.
  nationalId    String?        @map("national_id")
  /// Never required. Farmers and ordinary members have no smartphones, and the product must work
  /// perfectly for a member with no phone at all.
  phone         String?
  email         String?
  province      String?
  district      String?
  sector        String?
  cell          String?
  village       String?
  joinedOn      DateTime       @map("joined_on") @db.Date
  position      MemberPosition @default(MEMBER)
  status        MemberStatus   @default(ACTIVE)
  exitedOn      DateTime?      @map("exited_on") @db.Date
  exitReason    String?        @map("exit_reason")
  photoUrl      String?        @map("photo_url")
  notes         String?
  createdById   String?        @map("created_by_id") @db.Uuid
  updatedById   String?        @map("updated_by_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  cooperative         Cooperative            @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  deliveries          InventoryTransaction[]
  createdBy           User?                  @relation("MemberCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy           User?                  @relation("MemberUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  shares              MemberShare[]          @relation("ShareHolder")
  shareCounterparties MemberShare[]          @relation("ShareCounterparty")
  contributions       Contribution[]
  financeTransactions FinanceTransaction[]
  documents           Document[]
  meetingAttendance   MeetingAttendee[]
  smsMessages         SmsMessage[]

  @@unique([cooperativeId, memberCode])
  @@index([cooperativeId, status])
  @@index([cooperativeId, lastName, firstName])
  @@index([cooperativeId, joinedOn])
  @@map("members")
}

/// A ledger, not a balance. Current holding is the sum of inbound minus outbound over non-void
/// rows, so a correction is a new row and the history stays readable.
model MemberShare {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId        String               @map("cooperative_id") @db.Uuid
  memberId             String               @map("member_id") @db.Uuid
  type                 ShareTransactionType
  /// Always positive. Direction comes from `type`.
  quantity             Int
  unitValue            Decimal              @map("unit_value") @db.Decimal(14, 2)
  totalValue           Decimal              @map("total_value") @db.Decimal(14, 2)
  issuedOn             DateTime             @map("issued_on") @db.Date
  certificateNo        String?              @map("certificate_no")
  financeTransactionId String?              @unique @map("finance_transaction_id") @db.Uuid
  counterpartyMemberId String?              @map("counterparty_member_id") @db.Uuid
  note                 String?
  status               PostingStatus        @default(POSTED)
  voidedById           String?              @map("voided_by_id") @db.Uuid
  voidedAt             DateTime?            @map("voided_at") @db.Timestamptz(3)
  voidReason           String?              @map("void_reason")
  createdById          String?              @map("created_by_id") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  cooperative        Cooperative         @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  member             Member              @relation("ShareHolder", fields: [memberId], references: [id], onDelete: Restrict)
  counterpartyMember Member?             @relation("ShareCounterparty", fields: [counterpartyMemberId], references: [id], onDelete: Restrict)
  financeTransaction FinanceTransaction? @relation(fields: [financeTransactionId], references: [id], onDelete: Restrict)
  createdBy          User?               @relation("ShareCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy           User?               @relation("ShareVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([cooperativeId, memberId])
  @@index([cooperativeId, issuedOn])
  @@index([counterpartyMemberId])
  @@map("member_shares")
}

model Contribution {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId        String           @map("cooperative_id") @db.Uuid
  memberId             String           @map("member_id") @db.Uuid
  type                 ContributionType
  amount               Decimal          @db.Decimal(14, 2)
  paidOn               DateTime         @map("paid_on") @db.Date
  method               PaymentMethod
  reference            String?
  financeTransactionId String?          @unique @map("finance_transaction_id") @db.Uuid
  note                 String?
  status               PostingStatus    @default(POSTED)
  voidedById           String?          @map("voided_by_id") @db.Uuid
  voidedAt             DateTime?        @map("voided_at") @db.Timestamptz(3)
  voidReason           String?          @map("void_reason")
  createdById          String?          @map("created_by_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  cooperative        Cooperative         @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  member             Member              @relation(fields: [memberId], references: [id], onDelete: Restrict)
  financeTransaction FinanceTransaction? @relation(fields: [financeTransactionId], references: [id], onDelete: Restrict)
  createdBy          User?               @relation("ContributionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy           User?               @relation("ContributionVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)

  @@index([cooperativeId, memberId, paidOn])
  @@index([cooperativeId, paidOn])
  @@map("contributions")
}

model FinanceCategory {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId String      @map("cooperative_id") @db.Uuid
  kind          FinanceKind
  name          String
  nameRw        String?     @map("name_rw")
  code          String?
  /// Seeded for the cooperative's type. A system category cannot be deleted, only deactivated.
  isSystem      Boolean     @default(false) @map("is_system")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  cooperative  Cooperative          @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]

  @@unique([cooperativeId, kind, name])
  @@index([cooperativeId, kind, isActive])
  @@map("finance_categories")
}

/// The single money ledger. Balance is always the sum of INCOME minus the sum of EXPENSE over
/// POSTED rows. There is no separate Income, Expense or Payment table: one ledger means one
/// balance, one export, and one place to get the arithmetic right.
model FinanceTransaction {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId String            @map("cooperative_id") @db.Uuid
  /// `IN-2026-000123` / `EX-2026-000045`, unique per cooperative.
  reference     String
  kind          FinanceKind
  categoryId    String            @map("category_id") @db.Uuid
  /// Always positive. Direction lives in `kind`, never in the sign.
  amount        Decimal           @db.Decimal(14, 2)
  currency      String            @default("RWF")
  /// The accounting date the user chose, which is not the date the row was written.
  occurredAt    DateTime          @map("occurred_at") @db.Date
  method        PaymentMethod
  description   String
  sourceType    FinanceSourceType @default(MANUAL) @map("source_type")
  memberId      String?           @map("member_id") @db.Uuid
  /// Added in M7: the counterparty and the sale an income entry came from.
  buyerId       String?           @map("buyer_id") @db.Uuid
  saleId        String?           @map("sale_id") @db.Uuid
  status        PostingStatus     @default(POSTED)
  /// A correcting entry points at the row it reverses. Both stay visible in the history.
  reversalOfId  String?           @unique @map("reversal_of_id") @db.Uuid
  voidReason    String?           @map("void_reason")
  voidedById    String?           @map("voided_by_id") @db.Uuid
  voidedAt      DateTime?         @map("voided_at") @db.Timestamptz(3)
  createdById   String?           @map("created_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  cooperative  Cooperative           @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  category     FinanceCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  member       Member?               @relation(fields: [memberId], references: [id], onDelete: Restrict)
  buyer        Buyer?                @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  sale         Sale?                 @relation(fields: [saleId], references: [id], onDelete: Restrict)
  reversalOf   FinanceTransaction?   @relation("Reversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy   FinanceTransaction?   @relation("Reversal")
  createdBy    User?                 @relation("FinanceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  voidedBy     User?                 @relation("FinanceVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  contribution Contribution?
  memberShare  MemberShare?
  movement     InventoryTransaction?

  @@unique([cooperativeId, reference])
  @@index([cooperativeId, occurredAt])
  @@index([cooperativeId, kind, occurredAt])
  @@index([cooperativeId, categoryId, occurredAt])
  @@index([cooperativeId, status, occurredAt])
  @@index([cooperativeId, memberId])
  @@index([cooperativeId, saleId])
  @@map("finance_transactions")
}

/// Makes a retried write safe. A repeat of the same key returns the stored response instead of
/// creating a second transaction, which is what lets the client retry at all on a flaky
/// connection without the risk of duplicate money.
model IdempotencyKey {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId  String           @map("cooperative_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  key            String
  endpoint       String
  /// Hash of the request body. A replay with a different body is a mistake, not a retry.
  requestHash    String           @map("request_hash")
  responseStatus Int?             @map("response_status")
  responseBody   Json?            @map("response_body")
  state          IdempotencyState @default(IN_PROGRESS)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)

  cooperative Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cooperativeId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// M6 — catalogue, warehouses, inventory and notifications
// ---------------------------------------------------------------------------

enum ProductType {
  GOODS
  SERVICE

  @@map("product_type")
}

enum InventoryTransactionType {
  /// Stock arriving, including produce delivered by a member.
  RECEIPT
  /// Stock leaving for any reason other than a sale.
  ISSUE
  /// A count that disagreed with the record. Always carries a reason.
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  SALE_OUT
  SALE_RETURN
  /// What was already in the store when the cooperative started keeping records here.
  OPENING

  @@map("inventory_transaction_type")
}

/// Derived from the type and stored, so a sum over a period does not have to know the rules.
enum InventoryDirection {
  IN
  OUT

  @@map("inventory_direction")
}

enum NotificationType {
  LOW_STOCK
  MEETING_REMINDER
  REPORT_READY
  MEMBER_INCOMPLETE
  DOCUMENT
  TASK
  SYSTEM

  @@map("notification_type")
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL

  @@map("notification_severity")
}

/// A grouping for the catalogue, one level deep in practice but able to nest.
model ProductCategory {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId String   @map("cooperative_id") @db.Uuid
  name          String
  nameRw        String?  @map("name_rw")
  parentId      String?  @map("parent_id") @db.Uuid
  description   String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cooperative Cooperative       @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  parent      ProductCategory?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Restrict)
  children    ProductCategory[] @relation("CategoryParent")
  products    Product[]

  @@unique([cooperativeId, name, parentId])
  @@index([cooperativeId, isActive])
  @@map("product_categories")
}

/// Something the cooperative buys, stores, sells or supplies. A service is a product that is not
/// counted: `trackInventory` is what separates a bag of maize from a day of tractor hire.
model Product {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId        String      @map("cooperative_id") @db.Uuid
  sku                  String
  name                 String
  nameRw               String?     @map("name_rw")
  categoryId           String?     @map("category_id") @db.Uuid
  unitId               String      @map("unit_id") @db.Uuid
  type                 ProductType @default(GOODS)
  trackInventory       Boolean     @default(true) @map("track_inventory")
  /// Below this the low-stock scan raises a notification. Null means nobody wants warning.
  minStockLevel        Decimal?    @map("min_stock_level") @db.Decimal(14, 3)
  defaultPurchasePrice Decimal?    @map("default_purchase_price") @db.Decimal(14, 2)
  defaultSalePrice     Decimal?    @map("default_sale_price") @db.Decimal(14, 2)
  description          String?
  isActive             Boolean     @default(true) @map("is_active")
  createdById          String?     @map("created_by_id") @db.Uuid
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  cooperative Cooperative            @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  category    ProductCategory?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit        UnitOfMeasure          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdBy   User?                  @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  stockLevels StockLevel[]
  movements   InventoryTransaction[]
  saleItems   SaleItem[]

  @@unique([cooperativeId, sku])
  @@index([cooperativeId, isActive])
  @@index([cooperativeId, categoryId])
  @@map("products")
}

/// Where stock is kept. A cooperative with one store still has one of these, because a movement
/// has to say where it happened and a second store must not need a migration.
model Warehouse {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId String   @map("cooperative_id") @db.Uuid
  name          String
  code          String
  district      String?
  sector        String?
  /// Exactly one per cooperative, enforced by a partial unique index in the migration.
  isDefault     Boolean  @default(false) @map("is_default")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cooperative Cooperative            @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  stockLevels StockLevel[]
  movements   InventoryTransaction[]
  sales       Sale[]

  @@unique([cooperativeId, code])
  @@index([cooperativeId, isActive])
  @@map("warehouses")
}

/// The running balance, and a cache of `InventoryTransaction` rather than a source of truth: it
/// can be rebuilt from the movement history at any time and a test proves it reproduces exactly.
///
/// Every decrement is a conditional `UPDATE ... WHERE quantity >= :qty`. An affected-row count of
/// zero is an insufficient-stock refusal rather than a negative balance, which is what stops two
/// people selling the same sack.
model StockLevel {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId String   @map("cooperative_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  warehouseId   String   @map("warehouse_id") @db.Uuid
  quantity      Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cooperative Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([cooperativeId, quantity])
  @@map("stock_levels")
}

/// The immutable movement history. Nothing here is ever updated or deleted; a movement recorded in
/// error is reversed by an opposite movement that points at it, exactly as a finance entry is.
model InventoryTransaction {
  id                        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId             String                   @map("cooperative_id") @db.Uuid
  /// `STK-2026-000318`, unique per cooperative.
  reference                 String
  type                      InventoryTransactionType
  direction                 InventoryDirection
  productId                 String                   @map("product_id") @db.Uuid
  warehouseId               String                   @map("warehouse_id") @db.Uuid
  /// Always positive. Direction lives in `direction`, never in the sign.
  quantity                  Decimal                  @db.Decimal(14, 3)
  /// The unit at the time of the movement, so a later change to the product does not rewrite it.
  unitId                    String                   @map("unit_id") @db.Uuid
  unitCost                  Decimal?                 @map("unit_cost") @db.Decimal(14, 2)
  totalCost                 Decimal?                 @map("total_cost") @db.Decimal(14, 2)
  /// Set when a member delivered the produce, which is what "products supplied" on a member
  /// profile sums over. No separate deliveries table, so stock and member history cannot disagree.
  sourceMemberId            String?                  @map("source_member_id") @db.Uuid
  /// Added in M7: who the stock went to, and under which sale.
  buyerId                   String?                  @map("buyer_id") @db.Uuid
  saleId                    String?                  @map("sale_id") @db.Uuid
  /// Pairs the two halves of a transfer, so each names the other.
  counterpartyTransactionId String?                  @unique @map("counterparty_transaction_id") @db.Uuid
  reversalOfId              String?                  @unique @map("reversal_of_id") @db.Uuid
  /// Required for an adjustment: a count that disagreed with the record needs an explanation.
  reason                    String?
  note                      String?
  /// The finance entry this movement created, where the cooperative paid on receipt.
  financeTransactionId      String?                  @unique @map("finance_transaction_id") @db.Uuid
  occurredAt                DateTime                 @map("occurred_at") @db.Timestamptz(3)
  createdById               String?                  @map("created_by_id") @db.Uuid
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  cooperative        Cooperative           @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  product            Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse          Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  unit               UnitOfMeasure         @relation(fields: [unitId], references: [id], onDelete: Restrict)
  sourceMember       Member?               @relation(fields: [sourceMemberId], references: [id], onDelete: Restrict)
  buyer              Buyer?                @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  sale               Sale?                 @relation(fields: [saleId], references: [id], onDelete: Restrict)
  counterparty       InventoryTransaction? @relation("TransferPair", fields: [counterpartyTransactionId], references: [id], onDelete: Restrict)
  pairedWith         InventoryTransaction? @relation("TransferPair")
  reversalOf         InventoryTransaction? @relation("InventoryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy         InventoryTransaction? @relation("InventoryReversal")
  financeTransaction FinanceTransaction?   @relation(fields: [financeTransactionId], references: [id], onDelete: Restrict)
  createdBy          User?                 @relation("InventoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([cooperativeId, reference])
  @@index([cooperativeId, occurredAt])
  @@index([productId, occurredAt])
  @@index([cooperativeId, sourceMemberId])
  @@index([cooperativeId, warehouseId, occurredAt])
  @@index([cooperativeId, type, occurredAt])
  @@index([saleId])
  @@map("inventory_transactions")
}

/// Something the cooperative should know about, stored as a translation key and its parameters
/// rather than a rendered sentence: a notification raised while the interface was in English still
/// reads correctly in Kinyarwanda.
///
/// Created in M6 because the Phase 6 low-stock scan is the first thing that writes one. The
/// notification centre itself is Phase 12.
model Notification {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId String               @map("cooperative_id") @db.Uuid
  /// Null means every member of staff at the cooperative, which is what a low-stock alert is.
  userId        String?              @map("user_id") @db.Uuid
  type          NotificationType
  severity      NotificationSeverity @default(INFO)
  messageKey    String               @map("message_key")
  messageParams Json?                @map("message_params")
  entityType    String?              @map("entity_type")
  entityId      String?              @map("entity_id")
  actionUrl     String?              @map("action_url")
  /// What stops the same alert being raised every time the scanner runs.
  dedupeKey     String               @map("dedupe_key")
  readAt        DateTime?            @map("read_at") @db.Timestamptz(3)
  dismissedAt   DateTime?            @map("dismissed_at") @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  cooperative Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cooperativeId, dedupeKey])
  @@index([cooperativeId, userId, readAt])
  @@index([cooperativeId, createdAt(sort: Desc)])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// M7 — buyers and sales
// ---------------------------------------------------------------------------

enum SaleStatus {
  DRAFT
  CONFIRMED
  CANCELLED

  @@map("sale_status")
}

/// Derived from the income entries linked to the sale, never set by hand.
enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID

  @@map("payment_status")
}

/// Who the cooperative sells to: a trader, a school, a processor, a district office.
model Buyer {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId String   @map("cooperative_id") @db.Uuid
  name          String
  organization  String?
  contactPerson String?  @map("contact_person")
  phone         String?
  email         String?
  /// Taxpayer identification number, which a buyer needs on an invoice.
  tin           String?
  province      String?
  district      String?
  sector        String?
  address       String?
  notes         String?
  isActive      Boolean  @default(true) @map("is_active")
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cooperative Cooperative            @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  createdBy   User?                  @relation("BuyerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  sales       Sale[]
  movements   InventoryTransaction[]
  finance     FinanceTransaction[]

  @@unique([cooperativeId, name])
  @@index([cooperativeId, isActive])
  @@map("buyers")
}

/// A sale, which is a draft until somebody confirms it.
///
/// Nothing leaves the store and no money is recorded while it is a draft: that is the whole point
/// of the state. Confirming is one transaction that takes the stock, writes a movement for every
/// line, records any payment taken and marks the sale — all of it or none of it. A confirmed sale
/// can never return to draft; it is cancelled, which writes compensating movements.
model Sale {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId String        @map("cooperative_id") @db.Uuid
  /// `SL-2026-000045`, unique per cooperative.
  reference     String
  buyerId       String        @map("buyer_id") @db.Uuid
  /// Where the stock is taken from when the sale is confirmed.
  warehouseId   String        @map("warehouse_id") @db.Uuid
  saleDate      DateTime      @map("sale_date") @db.Date
  status        SaleStatus    @default(DRAFT)
  /// Derived from the linked income entries, never set directly.
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  discount      Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total         Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid    Decimal       @default(0) @map("amount_paid") @db.Decimal(14, 2)
  currency      String        @default("RWF")
  note          String?
  confirmedAt   DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt   DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelReason  String?       @map("cancel_reason")
  createdById   String?       @map("created_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  cooperative Cooperative            @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  buyer       Buyer                  @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  warehouse   Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy   User?                  @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items       SaleItem[]
  movements   InventoryTransaction[]
  finance     FinanceTransaction[]

  @@unique([cooperativeId, reference])
  @@index([cooperativeId, saleDate])
  @@index([cooperativeId, buyerId])
  @@index([cooperativeId, paymentStatus])
  @@index([cooperativeId, status, saleDate])
  @@map("sales")
}

/// One line of a sale. Cascades with the sale, because a line has no meaning without it and a
/// draft's lines are edited freely until the sale is confirmed.
model SaleItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId    String   @map("sale_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Decimal  @db.Decimal(14, 3)
  /// The unit at the time of the sale, so a later change to the product does not rewrite it.
  unitId    String   @map("unit_id") @db.Uuid
  unitPrice Decimal  @map("unit_price") @db.Decimal(14, 2)
  lineTotal Decimal  @map("line_total") @db.Decimal(14, 2)
  note      String?
  /// Keeps the order the lines were entered in, which is the order they are read back.
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sale    Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit    UnitOfMeasure @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([saleId, position])
  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// ---------------------------------------------------------------------------
// M8 — report runs
// ---------------------------------------------------------------------------

enum ReportFormat {
  PDF
  CSV
  XLSX

  @@map("report_format")
}

enum ReportStatus {
  PENDING
  READY
  FAILED

  @@map("report_status")
}

/// A record that a report was produced: which one, over what period, by whom, and when.
///
/// Its purpose is accountability rather than caching. A cooperative that took a figure to a lender
/// in March has to be able to say what it asked for and when, and a report handed round a general
/// assembly needs a record of who produced it. The parameters are kept so the same request can be
/// made again without anybody having to remember what they typed.
model ReportRun {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId String       @map("cooperative_id") @db.Uuid
  /// One of the catalogue keys in `packages/shared/src/reports.ts`.
  type          String
  /// The range and any filters, exactly as they were validated.
  params        Json
  format        ReportFormat
  status        ReportStatus @default(PENDING)
  /// Where the produced file lives, once there is file storage. Null until then: a download
  /// re-runs the report from `params` rather than serving a stored copy.
  storageKey    String?      @map("storage_key")
  errorMessage  String?      @map("error_message")
  /// How many rows the report covered, so a run is legible in a list without being re-run.
  rowCount      Int?         @map("row_count")
  generatedById String?      @map("generated_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(3)

  cooperative Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  generatedBy User?       @relation("ReportGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)

  @@index([cooperativeId, createdAt(sort: Desc)])
  @@index([cooperativeId, type, createdAt(sort: Desc)])
  @@map("report_runs")
}

// ---------------------------------------------------------------------------
// M9 — documents and meetings
// ---------------------------------------------------------------------------

enum DocumentCategory {
  REGISTRATION
  FINANCIAL
  MEMBER
  CONTRACT
  CERTIFICATE
  MEETING_MINUTES
  REPORT
  OTHER

  @@map("document_category")
}

/// Who may see a document. `COOPERATIVE` is everybody with `documents:view`; `RESTRICTED` narrows
/// it to the person who uploaded it and to staff who hold `documents:archive`, which is the
/// custodian permission. A cooperative's land title and a member's medical letter are not the same
/// kind of paper, and one visibility for both would mean either over-sharing or a locked cabinet.
enum DocumentVisibility {
  COOPERATIVE
  RESTRICTED

  @@map("document_visibility")
}

/// A file the cooperative keeps.
///
/// The row is the record and the bytes live in object storage under `storageKey`, which is random
/// and never derived from the filename, so a key cannot be guessed from anything a user has seen.
/// Nothing is ever publicly readable: a download goes through an endpoint that authenticates,
/// resolves the tenant, checks the permission and then streams.
///
/// A document is archived, never deleted. A cooperative's registration certificate, a member's
/// contract and a set of minutes are the records an auditor asks for years later, and a row that
/// could be removed is a record that can be made to have never existed.
model Document {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId  String             @map("cooperative_id") @db.Uuid
  title          String
  category       DocumentCategory   @default(OTHER)
  /// The name the file arrived with, kept only so a download can offer it again. Never used to
  /// build a path, and escaped wherever it is shown.
  fileName       String             @map("file_name")
  /// Unguessable, random, and unique across the whole installation.
  storageKey     String             @unique @map("storage_key")
  mimeType       String             @map("mime_type")
  sizeBytes      BigInt             @map("size_bytes")
  /// Lets a cooperative prove the file it downloads is the file it uploaded.
  checksumSha256 String             @map("checksum_sha256")
  visibility     DocumentVisibility @default(COOPERATIVE)
  /// The member this paper belongs to, where it belongs to one.
  memberId       String?            @map("member_id") @db.Uuid
  /// The meeting this paper belongs to, where it belongs to one.
  meetingId      String?            @map("meeting_id") @db.Uuid
  description    String?
  tags           String[]           @default([])
  uploadedById   String?            @map("uploaded_by_id") @db.Uuid
  isArchived     Boolean            @default(false) @map("is_archived")
  archivedAt     DateTime?          @map("archived_at") @db.Timestamptz(3)
  archivedById   String?            @map("archived_by_id") @db.Uuid
  archiveReason  String?            @map("archive_reason")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  cooperative Cooperative @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  member      Member?     @relation(fields: [memberId], references: [id], onDelete: Restrict)
  meeting     Meeting?    @relation("MeetingDocuments", fields: [meetingId], references: [id], onDelete: Restrict)
  uploadedBy  User?       @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  archivedBy  User?       @relation("DocumentArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  minutesOf   Meeting?    @relation("MeetingMinutes")

  @@index([cooperativeId, category])
  @@index([cooperativeId, createdAt(sort: Desc)])
  @@index([cooperativeId, isArchived])
  @@index([cooperativeId, memberId])
  @@index([cooperativeId, meetingId])
  @@map("documents")
}

enum MeetingType {
  GENERAL_ASSEMBLY
  BOARD
  COMMITTEE
  EXTRAORDINARY
  OTHER

  @@map("meeting_type")
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("meeting_status")
}

/// A meeting of the cooperative.
///
/// This is the governance record a Rwandan cooperative is required to keep: an assembly is called,
/// an agenda is circulated, attendance is taken against the register, decisions are recorded with
/// their votes, and the minutes are filed. Quorum matters legally, so the number required is stored
/// on the meeting and the attendance is counted against it rather than being asserted in prose.
model Meeting {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId     String        @map("cooperative_id") @db.Uuid
  reference         String
  title             String
  type              MeetingType   @default(GENERAL_ASSEMBLY)
  scheduledFor      DateTime      @map("scheduled_for") @db.Timestamptz(3)
  endsAt            DateTime?     @map("ends_at") @db.Timestamptz(3)
  location          String?
  status            MeetingStatus @default(SCHEDULED)
  /// How many members must attend for the meeting to decide anything. Null where the cooperative's
  /// own rules do not set one.
  quorumRequired    Int?          @map("quorum_required")
  notes             String?
  minutesDocumentId String?       @unique @map("minutes_document_id") @db.Uuid
  cancelReason      String?       @map("cancel_reason")
  createdById       String?       @map("created_by_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  cooperative     Cooperative         @relation(fields: [cooperativeId], references: [id], onDelete: Restrict)
  minutesDocument Document?           @relation("MeetingMinutes", fields: [minutesDocumentId], references: [id], onDelete: Restrict)
  createdBy       User?               @relation("MeetingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  agenda          MeetingAgendaItem[]
  attendees       MeetingAttendee[]
  decisions       MeetingDecision[]
  documents       Document[]          @relation("MeetingDocuments")

  @@unique([cooperativeId, reference])
  @@index([cooperativeId, scheduledFor(sort: Desc)])
  @@index([cooperativeId, status])
  @@map("meetings")
}

/// One item on the agenda, in the order it will be taken.
model MeetingAgendaItem {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId        String  @map("meeting_id") @db.Uuid
  position         Int
  title            String
  description      String?
  presenterStaffId String? @map("presenter_staff_id") @db.Uuid

  meeting   Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  presenter CooperativeStaff? @relation("AgendaPresenter", fields: [presenterStaffId], references: [id], onDelete: Restrict)
  decisions MeetingDecision[] @relation("DecisionAgendaItem")

  @@unique([meetingId, position])
  @@index([meetingId])
  @@map("meeting_agenda_items")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED

  @@map("attendance_status")
}

/// Who was at the meeting.
///
/// A row names exactly one of a member, a member of staff, or a guest, which a check constraint
/// enforces. Attendance taken against the register is what makes quorum provable; a free-text list
/// of names would not be.
model MeetingAttendee {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId   String           @map("meeting_id") @db.Uuid
  memberId    String?          @map("member_id") @db.Uuid
  staffId     String?          @map("staff_id") @db.Uuid
  guestName   String?          @map("guest_name")
  status      AttendanceStatus @default(PRESENT)
  checkedInAt DateTime?        @map("checked_in_at") @db.Timestamptz(3)
  note        String?

  meeting Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member  Member?           @relation(fields: [memberId], references: [id], onDelete: Restrict)
  staff   CooperativeStaff? @relation("AttendeeStaff", fields: [staffId], references: [id], onDelete: Restrict)

  @@unique([meetingId, memberId])
  @@index([meetingId])
  @@index([memberId])
  @@map("meeting_attendees")
}

enum DecisionType {
  RESOLUTION
  ACTION
  NOTE

  @@map("decision_type")
}

enum DecisionStatus {
  OPEN
  DONE
  CANCELLED

  @@map("decision_status")
}

/// What the meeting decided.
///
/// The votes are stored as three counts rather than as a verdict, because a cooperative's minutes
/// have to show how a decision was carried and not merely that it was. An action carries who is
/// responsible and by when, so the next meeting can ask.
model MeetingDecision {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  meetingId          String         @map("meeting_id") @db.Uuid
  agendaItemId       String?        @map("agenda_item_id") @db.Uuid
  title              String
  description        String?
  decisionType       DecisionType   @default(RESOLUTION) @map("decision_type")
  votesFor           Int?           @map("votes_for")
  votesAgainst       Int?           @map("votes_against")
  abstentions        Int?
  dueOn              DateTime?      @map("due_on") @db.Date
  responsibleStaffId String?        @map("responsible_staff_id") @db.Uuid
  status             DecisionStatus @default(OPEN)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  meeting     Meeting            @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  agendaItem  MeetingAgendaItem? @relation("DecisionAgendaItem", fields: [agendaItemId], references: [id], onDelete: SetNull)
  responsible CooperativeStaff?  @relation("DecisionResponsible", fields: [responsibleStaffId], references: [id], onDelete: Restrict)

  @@index([meetingId])
  @@index([responsibleStaffId, status])
  @@map("meeting_decisions")
}

// ---------------------------------------------------------------------------
// M12 — announcements and SMS
// ---------------------------------------------------------------------------

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("announcement_status")
}

/// Who an announcement is for.
///
/// The distinction that matters is not a permission but a delivery route. `STAFF` is read in the
/// application by the people who work there. The two member audiences reach people who mostly do
/// not have a smartphone, so publishing to them can also send an SMS — which is the whole reason
/// this module exists rather than a notice on a screen nobody's members will ever open.
enum AnnouncementAudience {
  ALL_MEMBERS
  ACTIVE_MEMBERS
  STAFF

  @@map("announcement_audience")
}

/// A message a cooperative writes once and sends to the people it is for.
///
/// Bilingual by construction: `title`/`body` and their `*_rw` counterparts, because a cooperative
/// writing to its members writes in Kinyarwanda and a district office reading the same
/// announcement may want the English. Only one pair is required; the other is optional, so nobody
/// is made to write twice to send a single sentence.
///
/// Never deleted. A published announcement is part of what the cooperative told its members, which
/// is exactly the kind of record a committee is later asked about, so it is archived with a reason.
model Announcement {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId String               @map("cooperative_id") @db.Uuid
  title         String
  titleRw       String?              @map("title_rw")
  body          String
  bodyRw        String?              @map("body_rw")
  audience      AnnouncementAudience @default(ACTIVE_MEMBERS)
  status        AnnouncementStatus   @default(DRAFT)
  /// Set once, when it is published. A published announcement's text can no longer change.
  publishedAt   DateTime?            @map("published_at") @db.Timestamptz(3)
  publishedById String?              @map("published_by_id") @db.Uuid
  archivedAt    DateTime?            @map("archived_at") @db.Timestamptz(3)
  archiveReason String?              @map("archive_reason")
  createdById   String               @map("created_by_id") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  cooperative Cooperative  @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy User?        @relation("AnnouncementPublisher", fields: [publishedById], references: [id], onDelete: Restrict)
  messages    SmsMessage[]

  @@index([cooperativeId, status, createdAt(sort: Desc)])
  @@index([cooperativeId, publishedAt(sort: Desc)])
  @@map("announcements")
}

enum SmsStatus {
  QUEUED
  SENT
  FAILED

  @@map("sms_status")
}

/// Every message this application has asked a provider to send.
///
/// The log is the product, not a debugging aid. A cooperative that tells fifty members a meeting
/// has moved needs to be able to say afterwards which fifty were told, at what number, and which
/// ones failed — a claim nobody can make from a provider's dashboard they do not have access to.
///
/// `to_phone` and `body` are **snapshots**. A member's number changes and an announcement is
/// archived; what was sent stays what was sent.
///
/// `dedupe_key` is unique per cooperative and is what makes "fifty messages, no duplicates" a
/// property of the database rather than of the code that happened to run. For an announcement it
/// names the announcement and the member, so publishing twice cannot send twice.
model SmsMessage {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId     String    @map("cooperative_id") @db.Uuid
  announcementId    String?   @map("announcement_id") @db.Uuid
  memberId          String?   @map("member_id") @db.Uuid
  toPhone           String    @map("to_phone")
  body              String
  status            SmsStatus @default(QUEUED)
  /// Which driver handled it, so a log read a year later says who was asked.
  provider          String
  providerMessageId String?   @map("provider_message_id")
  failureReason     String?   @map("failure_reason")
  dedupeKey         String    @map("dedupe_key")
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(3)
  createdById       String?   @map("created_by_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  cooperative  Cooperative   @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: Restrict)
  member       Member?       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  createdBy    User?         @relation("SmsSender", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([cooperativeId, dedupeKey])
  @@index([cooperativeId, createdAt(sort: Desc)])
  @@index([announcementId])
  @@index([memberId])
  @@map("sms_messages")
}

// ---------------------------------------------------------------------------
// M14 — the assistant
// ---------------------------------------------------------------------------

enum AssistantRole {
  USER
  ASSISTANT

  @@map("assistant_role")
}

/// One thread of questions, so a reader can look back at what they asked.
model AssistantConversation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cooperativeId String   @map("cooperative_id") @db.Uuid
  /// Whose conversation it is. Nobody else may read it, not even a manager.
  userId        String   @map("user_id") @db.Uuid
  /// The first question, trimmed, so a list of threads is readable.
  title         String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cooperative Cooperative        @relation(fields: [cooperativeId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    AssistantMessage[]

  @@index([cooperativeId, userId, updatedAt(sort: Desc)])
  @@map("assistant_conversations")
}

/// A question, or an answer.
///
/// An answer is **not** stored as prose. `answer_key` and `answer_params` are a translation key and
/// its values, exactly as a notification is, so the same answer reads in English or in Kinyarwanda
/// and an answer given last year still reads correctly in a language the cooperative switched to
/// since. Nothing in this table is a sentence a model wrote.
///
/// `figures` holds what the reader is shown beside the answer, and `data_snapshot` holds the rows
/// the tool returned — so any figure the assistant states can be traced to the query that produced
/// it, which is the whole basis of the phase's guarantee.
model AssistantMessage {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  role           AssistantRole
  /// The question as it was typed. Null on an answer, which carries a key instead.
  question       String?
  answerKey      String?       @map("answer_key")
  answerParams   Json?         @map("answer_params")
  /// Which tool answered, or null where none fitted and the assistant said so.
  tool           String?
  toolArgs       Json?         @map("tool_args")
  figures        Json?
  dataSnapshot   Json?         @map("data_snapshot")
  /// The screen the answer points at, so a reader can go and see it for themselves.
  href           String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}
