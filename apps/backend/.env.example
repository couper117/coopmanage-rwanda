# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# PostgreSQL. DIRECT_URL is the unpooled connection used by prisma migrate.
DATABASE_URL="postgresql://coopmanage:coopmanage@localhost:5435/coopmanage?schema=public"
DIRECT_URL="postgresql://coopmanage:coopmanage@localhost:5435/coopmanage?schema=public"

# Comma-separated list of allowed browser origins.
CORS_ORIGINS="http://localhost:5175"

# Authentication. Generate the secret with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-me-with-a-long-random-value"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60

# Where the browser application is served. Password reset links are built against it.
APP_BASE_URL="http://localhost:5175"

# Where uploaded documents are kept. `local` writes to STORAGE_LOCAL_PATH, which is git-ignored and
# must sit outside anything served statically. `s3` is the Supabase Storage driver and arrives in
# Phase 18; setting it now makes the process refuse to start rather than quietly writing a
# cooperative's documents to a container that is replaced on the next deployment.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"
# The cap on one uploaded file, in megabytes.
MAX_UPLOAD_MB=10

# Which SMS provider carries a cooperative's announcements to its members.
#
# `mock` is the only value and it needs no credentials: every message is written to the log with
# its body and its number, and none is delivered. Development therefore runs with no SMS account,
# a reviewer can send to a hundred members without a hundred real people receiving a test, and
# every screen that sends says plainly that messages are being recorded rather than delivered.
# A real gateway lands with the account it needs rather than as an adapter nobody has run.
SMS_PROVIDER="mock"
# The name messages appear to come from, where the gateway supports one. Leave it unset unless a
# gateway has assigned one: a made-up sender is worse than none.
# SMS_SENDER_ID=

# Which planner reads a question for the assistant and picks a tool to answer it with.
#
# `rules` is the only value and it needs no credentials: it matches the words in a question against
# a fixed table in English and Kinyarwanda. A model-backed planner lands behind the same interface
# when there is an account to run it under, and setting `model` now makes the process refuse to
# start rather than fail on every question.
#
# The guarantee does not depend on which is live: a planner only ever chooses a tool and proposes
# arguments, and every figure in an answer comes from a query. See docs/assistant.md.
ASSISTANT_PLANNER="rules"

# Seed the demonstration cooperative alongside the reference data.
SEED_DEMO=false

# The platform administrator the seed creates. Without SEED_ADMIN_PASSWORD the seed generates a
# random one and prints it once; it is never stored anywhere else and there is no default.
# In production the account is not created at all unless a password is given.
SEED_ADMIN_EMAIL="admin@coopmanage.rw"
# SEED_ADMIN_PASSWORD=
# Password for the five demonstration staff accounts. Same rule: generated and printed if unset.
# SEED_DEMO_PASSWORD=

# Serve Swagger UI at /api/v1/docs.
ENABLE_API_DOCS=true
