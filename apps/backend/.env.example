# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# PostgreSQL. DIRECT_URL is the unpooled connection used by prisma migrate.
DATABASE_URL="postgresql://coopmanage:coopmanage@localhost:5435/coopmanage?schema=public"
DIRECT_URL="postgresql://coopmanage:coopmanage@localhost:5435/coopmanage?schema=public"

# Comma-separated list of allowed browser origins.
CORS_ORIGINS="http://localhost:5175"

# Authentication (used from Phase 2). Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-me-with-a-long-random-value"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Seed the demonstration cooperative alongside the reference data.
SEED_DEMO=false

# Serve Swagger UI at /api/v1/docs.
ENABLE_API_DOCS=true
