{
  "name": "@coopmanage/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:backup": "tsx src/scripts/backup-db.ts",
    "db:restore": "tsx src/scripts/restore-db.ts",
    "check:env": "tsx src/scripts/check-env.ts",
    "prisma:generate": "prisma generate",
    "purge-test-data": "tsx test/purge-cli.ts",
    "inventory:rebuild": "tsx src/scripts/rebuild-stock.ts"
  },
  "dependencies": {
    "@coopmanage/shared": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@types/pg": "^8.23.1",
    "argon2": "^0.44.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "prisma": "7.10.0",
    "tsx": "^4.19.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.2.2",
    "vitest": "^5.0.0"
  }
}
